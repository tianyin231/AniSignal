# 必填：分别填写独立的随机长字符串（建议 >= 32 字符，例如 openssl rand -hex 24）
# 注意：若密码或令牌中含有 $ 或 #，请用单引号 '...' 包裹整串值，避免被 Docker Compose 截断或展开
MYSQL_ROOT_PASSWORD=
ANISIGNAL_ADMIN_TOKEN=

# 对外访问地址：本机试用保持默认；绑定域名或反代时改成实际公开地址（如 https://signal.example.com）
ANISIGNAL_PUBLIC_BASE_URL=http://127.0.0.1:8090

# 宿主机监听地址与端口：默认仅本机可访问；局域网或无反代直连可改为 0.0.0.0:8090
WEB_PORT=127.0.0.1:8090

# 可选：若宿主机开启了 Clash / mihomo TUN fake-ip 模式导致 RSS 报私有网络错误，取消下一行注释
# ANISIGNAL_EGRESS_ALLOW_CIDRS=198.18.0.0/15
